# FORMS environment template
# Copy to .env and fill in real values. NEVER commit .env - it is gitignored.
# Client-safe values (EXPO_PUBLIC_* / NEXT_PUBLIC_*) end up in shipped bundles;
# everything else is server-side only.

# ── Supabase ──────────────────────────────────────────────
# Project URL + anon key are public (client-safe, protected by RLS).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: SERVER ONLY (pipeline worker, admin API routes). Full DB access.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin panel (apps/web, server only) ───────────────────
# Comma-separated emails allowed into /admin until profiles.role exists.
ADMIN_ALLOWLIST=

# ── Onshape (pipeline worker only) ────────────────────────
# API keys from https://dev-portal.onshape.com - use a company account, not personal.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_BASE_URL=https://cad.onshape.com
# The TEMPLATE part studio ids: a private copy of the CAD model, never the
# original. Each job copies this template and edits only the copy.
ONSHAPE_DOCUMENT_ID=
ONSHAPE_WORKSPACE_ID=
ONSHAPE_ELEMENT_ID=
# Comma-separated document ids the pipeline refuses to target or delete
# (the original model the template was copied from).
ONSHAPE_PROTECTED_DOCUMENT_IDS=

# ── Stripe ────────────────────────────────────────────────
# Publishable key is client-safe; secret + webhook secret are server only.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ── Observability ─────────────────────────────────────────
SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Pipeline worker ───────────────────────────────────────
PIPELINE_ENV=development
# Postgres connection string (Supabase db, server only). Used for the job queue.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Server-side Supabase URL for the worker (same project as the public URLs above).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Max mesh upload size in MB (untrusted-input cap, see docs/DESIGN.md §9.6)
PIPELINE_MAX_MESH_MB=100
# Comma-separated pipeline steps this worker claims. Empty = every step it has a
# handler for. The Mac reconstruction worker sets WORKER_STEPS=reconstructing;
# unknown or unregistered step names stop the worker at startup.
WORKER_STEPS=

# ── Retention sweep (pipeline worker, see services/pipeline README) ─
# Days after a scan's pipeline job completes before its raw mesh is deleted.
RETENTION_DAYS=30
# Max scans processed per sweep run.
RETENTION_BATCH_SIZE=100
# Safe by default: must be explicitly "false" for the sweep to delete anything.
RETENTION_DRY_RUN=true

# ── Onshape job documents (pipeline worker only) ──────────
# Each job copies the template document. Job copies hold customer body
# measurements, so a copy Onshape makes public is deleted and the job fails
# unless this is true.
ONSHAPE_ALLOW_PUBLIC_JOB_DOCUMENTS=false
# true keeps each job's copy instead of deleting it (debugging only).
ONSHAPE_KEEP_JOB_DOCUMENTS=false

# ── Photo reconstruction (Mac worker only, forms_pipeline/reconstruct) ──
# Path to the forms-reconstruct Swift CLI (build with: make build-reconstruct).
# Default: services/reconstruct/.build/release/forms-reconstruct in this repo.
# RECONSTRUCT_CLI=
# Wall-clock cap in seconds for one reconstruction run.
# RECONSTRUCT_TIMEOUT_S=1800
# PhotogrammetrySession detail level: reduced or medium.
# RECONSTRUCT_DETAIL=reduced
