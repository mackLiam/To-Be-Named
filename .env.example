# FORMS environment template
# Copy to .env and fill in real values. NEVER commit .env - it is gitignored.
# Client-safe values (EXPO_PUBLIC_* / NEXT_PUBLIC_*) end up in shipped bundles;
# everything else is server-side only.

# ── Supabase ──────────────────────────────────────────────
# Project URL + anon key are public (client-safe, protected by RLS).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Website origin the app calls for checkout (POST /api/checkout); unset disables ordering.
EXPO_PUBLIC_API_URL=https://zells.com
# Dev builds only: "true" switches silhouette capture to the Phase 0.5 sweep
# (the worker also needs SWEEP_CAPTURE_ENABLED=true). Ignored in production.
EXPO_PUBLIC_SWEEP_CAPTURE=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: SERVER ONLY (pipeline worker, admin API routes). Full DB access.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin panel (apps/web, server only) ───────────────────
# Comma-separated emails allowed into /admin (admin also needs TOTP MFA; see apps/web/README.md).
ADMIN_ALLOWLIST=

# ── Onshape (pipeline worker only) ────────────────────────
# API keys from https://dev-portal.onshape.com - use a company account, not personal.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_BASE_URL=https://cad.onshape.com
# The TEMPLATE part studio ids: a private copy of the CAD model, never the
# original. Each job copies this template and edits only the copy.
ONSHAPE_DOCUMENT_ID=
ONSHAPE_WORKSPACE_ID=
ONSHAPE_ELEMENT_ID=
# Comma-separated document ids the pipeline refuses to target or delete
# (the original model the template was copied from).
ONSHAPE_PROTECTED_DOCUMENT_IDS=

# ── Stripe ────────────────────────────────────────────────
# Publishable key is client-safe; secret + webhook secret are server only.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Public origin of apps/web (no trailing slash); Checkout returns to /checkout/* here.
SITE_URL=https://zells.com
# Comma list of exact browser origins allowed to call /api/checkout (the Expo web build).
CHECKOUT_ALLOWED_ORIGINS=https://app.zells.com
# Comma list of ISO 3166-1 alpha-2 codes Checkout ships to (default US, at most 50).
# A malformed or duplicate code fails checkout with a config error.
STRIPE_SHIPPING_COUNTRIES=US
# Optional Checkout gates (apps/web/src/lib/env.ts getCheckoutGates). Server only,
# all OFF when unset or empty. Flags accept exactly "true"; any other value
# (TRUE, 1, yes) fails checkout with a config error, never silently on.
# The paid total (tax, shipping, discounts) is what the order stores as
# amount_cents; the webhook RPC (0013) records it and does not compare it to the price.
# Stripe Tax adds tax to the session, computed on the shipping address.
# TODO(liam): decide tax registrations, add them in Stripe Tax, set the origin
# address and the default tax behavior (inclusive or exclusive) and product
# tax code in the Stripe Tax settings before turning this on.
STRIPE_AUTOMATIC_TAX=
# Comma list of Stripe shipping rate ids (shr_...), at most 5, shown in this order.
# TODO(liam): choose carrier, prices and countries, then create the shipping rates
# in the Stripe dashboard, with a tax behavior on each if Stripe Tax is on.
STRIPE_SHIPPING_RATE_IDS=
# Require the customer to accept the terms of service at Checkout.
# TODO(liam): set the terms of service URL (SITE_URL + /terms) in the Stripe
# dashboard public details (dashboard.stripe.com/settings/public) first, or
# session creation fails.
STRIPE_TERMS_CONSENT=
# Let the customer enter a Stripe promotion code at Checkout.
# TODO(liam): create coupons and promotion codes in the Stripe dashboard. Never a
# code that can bring the total to 0: Stripe then completes the session with
# payment_status no_payment_required, which the webhook ignores, so the order
# would never become paid.
STRIPE_ALLOW_PROMOTION_CODES=

# ── Observability ─────────────────────────────────────────
SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Pipeline worker ───────────────────────────────────────
PIPELINE_ENV=development
# Postgres connection string (Supabase db, server only). Used for the job queue.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Server-side Supabase URL for the worker (same project as the public URLs above).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Max mesh upload size in MB (untrusted-input cap, see docs/DESIGN.md §9.6)
PIPELINE_MAX_MESH_MB=100
# Comma-separated pipeline steps this worker claims. Empty = every step it has a
# handler for. The Mac reconstruction worker sets WORKER_STEPS=reconstructing;
# unknown or unregistered step names stop the worker at startup.
WORKER_STEPS=

# ── Retention sweep (pipeline worker, see services/pipeline README) ─
# Days after a scan's pipeline job completes before its raw mesh is deleted.
RETENTION_DAYS=30
# Max scans processed per sweep run.
RETENTION_BATCH_SIZE=100
# Safe by default: must be explicitly "false" for the sweep to delete anything.
RETENTION_DRY_RUN=true

# ── Onshape job documents (pipeline worker only) ──────────
# Each job copies the template document. Job copies hold customer body
# measurements, so a copy Onshape makes public is deleted and the job fails
# unless this is true.
ONSHAPE_ALLOW_PUBLIC_JOB_DOCUMENTS=false
# true keeps each job's copy instead of deleting it (debugging only).
ONSHAPE_KEEP_JOB_DOCUMENTS=false

# ── Photo reconstruction (Mac worker only, forms_pipeline/reconstruct) ──
# Path to the forms-reconstruct Swift CLI (build with: make build-reconstruct).
# Default: services/reconstruct/.build/release/forms-reconstruct in this repo.
# RECONSTRUCT_CLI=
# Wall-clock cap in seconds for one reconstruction run.
# RECONSTRUCT_TIMEOUT_S=1800
# PhotogrammetrySession detail level: reduced or medium.
# RECONSTRUCT_DETAIL=reduced
# Dev flag (SCAN-V3-PLAN.md Phase 0.5): accept sweep capture bundles (stations
# sweep_NN, up to 24 photos). Off by default: they are rejected as a rescan.
SWEEP_CAPTURE_ENABLED=false

# ── Email (apps/web server only) ──────────────────────────
# Resend API key for transactional order emails. Unset = emails are skipped.
RESEND_API_KEY=
# From address for order emails, e.g. "FORMS <orders@your-domain>". Unset = emails are skipped.
EMAIL_FROM=
