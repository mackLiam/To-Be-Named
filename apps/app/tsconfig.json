{
  "extends": ["../../tsconfig.base.json", "expo/tsconfig.base"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // app.config.ts imports packages/shared/src/brand.ts by path; Expo evaluates
    // the config in Node, which only resolves the file with its extension.
    "allowImportingTsExtensions": true
  },
  "include": [
    "app.config.ts",
    "app",
    "src",
    "modules",
    "vitest.config.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
